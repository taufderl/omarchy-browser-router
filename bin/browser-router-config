#!/usr/bin/env python3
"""Validate, edit, and query browser-router's config.yaml.

Config parsing and domain resolution live here in Python (with PyYAML)
rather than being reimplemented in shell -- see codlex-review.md for why
hand-rolled parsing of structured data is the wrong call for this tool.
bin/browser-router shells out to this script's `resolve` subcommand for
every link it opens; `check` and `add` are for interactive use.
"""

import argparse
import re
import sys
from pathlib import Path

try:
    import yaml
except ImportError:
    print("error: PyYAML is required (Arch/Omarchy package: python-yaml)", file=sys.stderr)
    sys.exit(1)

DEFAULT_CONFIG_PATH = Path.home() / ".config" / "browser-router" / "config.yaml"

# Same identifiers, same order, as `omarchy default browser --help`. Kept in
# sync with omarchy-default-browser's desktop-id mapping below rather than
# hardcoding binary names: extending this to a new browser is one entry here.
BROWSER_IDS = ["chromium", "chrome", "brave", "brave-origin", "edge", "firefox", "zen"]

BROWSER_DESKTOP_IDS = {
    "chromium": "chromium.desktop",
    "chrome": "google-chrome.desktop",
    "brave": "brave-browser.desktop",
    "brave-origin": "brave-origin.desktop",
    "edge": "microsoft-edge.desktop",
    "firefox": "firefox.desktop",
    "zen": "zen.desktop",
}

# Same search order omarchy-launch-browser uses.
APPLICATION_DIRS = [
    Path.home() / ".local/share/applications",
    Path.home() / ".nix-profile/share/applications",
    Path("/usr/share/applications"),
]


def resolve_binary(browser_id: str) -> str | None:
    """The executable a browser id's installed .desktop file points at, or
    None if that browser isn't installed. Reads the Exec= line the same way
    omarchy-launch-browser does, rather than guessing binary names -- AUR
    packaging doesn't always name the binary after the package."""
    desktop_id = BROWSER_DESKTOP_IDS[browser_id]
    for directory in APPLICATION_DIRS:
        path = directory / desktop_id
        if not path.is_file():
            continue
        for line in path.read_text().splitlines():
            if line.startswith("Exec="):
                exec_line = line[len("Exec=") :].strip()
                if exec_line:
                    return exec_line.split()[0]
    return None

# A conservative hostname label pattern: lets through normal domains,
# rejects anything that looks like it carries a scheme, path, userinfo,
# or whitespace.
_DOMAIN_RE = re.compile(
    r"^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"
)


def is_valid_domain(domain: str) -> bool:
    return bool(domain) and bool(_DOMAIN_RE.match(domain))


class ConfigError(Exception):
    """Config failed to load or validate. Message is human-readable."""


def load_raw(path: Path) -> dict:
    if not path.exists():
        raise ConfigError(f"config file not found: {path}")
    try:
        with path.open("r") as f:
            data = yaml.safe_load(f)
    except yaml.YAMLError as e:
        raise ConfigError(f"invalid YAML in {path}: {e}") from e

    if data is None:
        data = {}
    if not isinstance(data, dict):
        raise ConfigError(f"{path}: top level must be a mapping, got {type(data).__name__}")
    return data


def validate(data: dict) -> list[str]:
    """Return a list of error strings. Empty list means valid."""
    errors: list[str] = []
    known_keys = set(BROWSER_IDS) | {"default"}

    for key in data:
        if key not in known_keys:
            errors.append(
                f"unknown key '{key}' (expected 'default' or one of: {', '.join(BROWSER_IDS)})"
            )

    if "default" not in data:
        errors.append("missing required key 'default'")
    elif data["default"] not in BROWSER_IDS:
        errors.append(
            f"'default: {data['default']!r}' must be one of: {', '.join(BROWSER_IDS)}"
        )

    seen: dict[str, str] = {}
    for browser in BROWSER_IDS:
        if browser not in data:
            continue
        domains = data[browser]
        if not isinstance(domains, list):
            errors.append(f"'{browser}' must be a list of domains, got {type(domains).__name__}")
            continue
        for domain in domains:
            if not isinstance(domain, str) or not is_valid_domain(domain.lower()):
                errors.append(f"'{browser}' has an invalid domain entry: {domain!r}")
                continue
            domain = domain.lower()
            if domain in seen:
                if seen[domain] == browser:
                    errors.append(f"'{browser}' lists '{domain}' more than once")
                else:
                    errors.append(
                        f"'{domain}' is listed under both '{seen[domain]}' and '{browser}'"
                    )
            else:
                seen[domain] = browser

    return errors


def load_validated(path: Path) -> dict:
    data = load_raw(path)
    errors = validate(data)
    if errors:
        raise ConfigError("\n".join(f"  - {e}" for e in errors))
    return data


def write_config(path: Path, data: dict) -> None:
    """Write `data` back out in canonical form: `default` first, then each
    BROWSER_IDS key in order with its domains sorted and lowercased. Used by
    every subcommand that edits the file, so the on-disk structure stays the
    same regardless of which one last touched it."""
    ordered = {"default": data["default"]}
    for b in BROWSER_IDS:
        ordered[b] = sorted(d.lower() for d in data.get(b, []))

    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w") as f:
        yaml.safe_dump(ordered, f, default_flow_style=False, sort_keys=False)


def resolve(data: dict, host: str) -> str:
    """Return the browser id to use for `host` (empty host -> default).

    Ties are broken by the longest (most specific) matching domain, not by
    BROWSER_IDS order -- see codex-review.md. Browser routing is meant as an
    isolation boundary: a broad rule in a browser that happens to come first
    in BROWSER_IDS must not silently win over a more specific rule for a
    subdomain routed to a different browser.
    """
    if not host:
        return data["default"]

    host = host.lower()
    best_domain = None
    best_browser = None
    for browser in BROWSER_IDS:
        for domain in data.get(browser, []):
            domain = domain.lower()
            if host == domain or host.endswith("." + domain):
                if best_domain is None or len(domain) > len(best_domain):
                    best_domain = domain
                    best_browser = browser

    return best_browser if best_browser is not None else data["default"]


def find_overlaps(data: dict) -> list[tuple[str, str, str, str]]:
    """Cross-browser parent/child domain pairs, as (parent, parent_browser,
    child, child_browser). Not an invalid config -- resolve() already picks
    the child, being more specific -- but worth surfacing in `check` so the
    precedence isn't a silent surprise."""
    entries = [
        (domain.lower(), browser)
        for browser in BROWSER_IDS
        for domain in data.get(browser, [])
    ]
    return [
        (parent, parent_browser, child, child_browser)
        for parent, parent_browser in entries
        for child, child_browser in entries
        if parent_browser != child_browser and child.endswith("." + parent)
    ]


def cmd_check(args: argparse.Namespace) -> int:
    path = Path(args.config)
    try:
        data = load_raw(path)
    except ConfigError as e:
        print(f"FAIL: {e}", file=sys.stderr)
        return 1

    errors = validate(data)
    if errors:
        print(f"FAIL: {path} is invalid:", file=sys.stderr)
        for e in errors:
            print(f"  - {e}", file=sys.stderr)
        return 1

    print(f"OK: {path} is valid")

    print(f"default: {data['default']}")
    for browser in BROWSER_IDS:
        count = len(data.get(browser, []))
        if count:
            print(f"{browser}: {count} domain{'s' if count != 1 else ''}")

    for parent, parent_browser, child, child_browser in find_overlaps(data):
        print(
            f"note: '{child}' ({child_browser}) is more specific than "
            f"'{parent}' ({parent_browser}) and takes precedence for it",
            file=sys.stderr,
        )

    referenced = {data["default"]}
    referenced.update(b for b in BROWSER_IDS if data.get(b))
    for browser in sorted(referenced):
        if resolve_binary(browser) is None:
            print(
                f"warning: '{browser}' is configured but not installed "
                f"(no {BROWSER_DESKTOP_IDS[browser]} found)",
                file=sys.stderr,
            )

    return 0


def cmd_add(args: argparse.Namespace) -> int:
    path = Path(args.config)
    browser = args.browser
    domain = args.domain.strip().lower()

    if browser not in BROWSER_IDS:
        print(f"error: unknown browser '{browser}' (expected one of: {', '.join(BROWSER_IDS)})", file=sys.stderr)
        return 2

    if not is_valid_domain(domain):
        print(f"error: '{args.domain}' doesn't look like a plain domain (no scheme, path, or @)", file=sys.stderr)
        return 2

    try:
        data = load_validated(path)
    except ConfigError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1

    for other in BROWSER_IDS:
        if other == browser:
            continue
        if domain in [d.lower() for d in data.get(other, [])]:
            print(f"error: '{domain}' is already routed to '{other}'; remove it there first", file=sys.stderr)
            return 1

    existing = [d.lower() for d in data.get(browser, [])]
    if domain in existing:
        print(f"'{domain}' is already routed to '{browser}'")
        return 0

    data.setdefault(browser, []).append(domain)

    errors = validate(data)
    if errors:
        # Shouldn't happen given the checks above, but don't write a config
        # we wouldn't accept ourselves.
        print("error: refusing to write an invalid config:", file=sys.stderr)
        for e in errors:
            print(f"  - {e}", file=sys.stderr)
        return 1

    write_config(path, data)

    print(f"Added '{domain}' -> '{browser}'")
    return 0


def cmd_resolve(args: argparse.Namespace) -> int:
    path = Path(args.config)
    try:
        data = load_validated(path)
    except ConfigError as e:
        print(str(e), file=sys.stderr)
        return 1

    browser = resolve(data, args.host)
    binary = resolve_binary(browser)
    if binary is None:
        print(
            f"'{browser}' is not installed (no {BROWSER_DESKTOP_IDS[browser]} found)",
            file=sys.stderr,
        )
        return 1

    print(binary)
    return 0


def cmd_default(args: argparse.Namespace) -> int:
    path = Path(args.config)
    try:
        data = load_validated(path)
    except ConfigError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1

    if args.browser is None:
        print(data["default"])
        return 0

    old = data["default"]
    new = args.browser
    if new == old:
        print(f"default is already '{old}'")
        return 0

    data["default"] = new

    errors = validate(data)
    if errors:
        # Shouldn't happen -- new is one of BROWSER_IDS by argparse choices --
        # but don't write a config we wouldn't accept ourselves.
        print("error: refusing to write an invalid config:", file=sys.stderr)
        for e in errors:
            print(f"  - {e}", file=sys.stderr)
        return 1

    write_config(path, data)

    print(f"Set default: {old} -> {new}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    # --config lives on each subcommand's own parser (via this shared
    # parent), not on the top-level parser too: argparse subparsers each
    # apply their own argument defaults to the namespace when invoked, so
    # defining --config in both places lets the subparser's default silently
    # clobber a value the top-level parser already set from the command
    # line. Only supporting `browser-router-config check --config X` (flag
    # after the subcommand), not before, sidesteps that entirely.
    config_option = argparse.ArgumentParser(add_help=False)
    config_option.add_argument(
        "--config",
        default=str(DEFAULT_CONFIG_PATH),
        help=f"path to config.yaml (default: {DEFAULT_CONFIG_PATH})",
    )

    parser = argparse.ArgumentParser(
        prog="browser-router-config",
        description="Validate, edit, and query browser-router's config.yaml.",
    )
    sub = parser.add_subparsers(dest="command")

    p_check = sub.add_parser("check", help="validate the config file", parents=[config_option])
    p_check.set_defaults(func=cmd_check)

    p_add = sub.add_parser("add", help="add a domain -> browser route", parents=[config_option])
    p_add.add_argument("browser", choices=BROWSER_IDS, help="browser id")
    p_add.add_argument("domain", help="domain to route to that browser")
    p_add.set_defaults(func=cmd_add)

    p_resolve = sub.add_parser(
        "resolve",
        help="print the binary to launch for a hostname (used internally by browser-router)",
        parents=[config_option],
    )
    p_resolve.add_argument("host", help="hostname to resolve, or an empty string for the default")
    p_resolve.set_defaults(func=cmd_resolve)

    p_default = sub.add_parser(
        "default",
        help="print the default browser, or set it if given one",
        parents=[config_option],
    )
    p_default.add_argument(
        "browser", nargs="?", default=None, choices=BROWSER_IDS, help="browser id to set as default"
    )
    p_default.set_defaults(func=cmd_default)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()

    if not getattr(args, "command", None):
        parser.print_help()
        return 0

    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
