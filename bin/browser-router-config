#!/usr/bin/env python3
"""Validate, edit, and query browser-router's config.yaml. Also owns URL
hostname extraction (extract_host) -- see its docstring for why.

bin/browser-router imports this module directly and calls its functions;
it does not shell out to this file's CLI. The CLI (check/set/reset/
get-default/set-default/installed/binary/resolve) is for interactive use
and any external caller that wants a subprocess boundary instead.
"""

import argparse
import json
import re
import shutil
import sys
from pathlib import Path

try:
    import yaml
except ImportError:
    print("error: PyYAML is required (Arch/Omarchy package: python-yaml)", file=sys.stderr)
    sys.exit(1)

DEFAULT_CONFIG_PATH = Path.home() / ".config" / "browser-router" / "config.yaml"

# Same identifiers, same order, as `omarchy default browser --help`.
BROWSER_IDS = ["chromium", "chrome", "brave", "brave-origin", "edge", "firefox", "zen"]

# `default` accepts a browser id, or "ask" to prompt instead of using a
# fixed fallback.
DEFAULT_VALUES = BROWSER_IDS + ["ask"]

# What resolve() falls back to when default is "ask" and should_ask() has
# already said no (empty host, or a plain non-asking caller). Same browser
# bin/browser-router's own last-resort exec falls back to.
FALLBACK_BROWSER = "brave"

BROWSER_DESKTOP_IDS = {
    "chromium": "chromium.desktop",
    "chrome": "google-chrome.desktop",
    "brave": "brave-browser.desktop",
    "brave-origin": "brave-origin.desktop",
    "edge": "microsoft-edge.desktop",
    "firefox": "firefox.desktop",
    "zen": "zen.desktop",
}

# Ask-mode popup display names only.
BROWSER_LABELS = {
    "chromium": "Chromium",
    "chrome": "Chrome",
    "brave": "Brave",
    "brave-origin": "Brave (Origin build)",
    "edge": "Edge",
    "firefox": "Firefox",
    "zen": "Zen",
}

# Same search order omarchy-launch-browser uses.
APPLICATION_DIRS = [
    Path.home() / ".local/share/applications",
    Path.home() / ".nix-profile/share/applications",
    Path("/usr/share/applications"),
]


def resolve_binary(browser_id: str) -> str | None:
    """The executable a browser id's .desktop Exec= line points at, or None
    if not installed. Looked up rather than guessed: AUR packaging doesn't
    reliably name the binary after the package.

    The first whitespace-split Exec= token is resolved through
    shutil.which() rather than handed back as-is: ~/.local/share/applications
    is user-writable (same-user, not a new privilege boundary, but still
    worth failing closed on) and the token wasn't otherwise checked to be
    an absolute path or an existing executable before being os.execvp'd.
    which() covers both a bare name (PATH search, matching what execvp
    would have done anyway) and an absolute path (existence + exec bit),
    so a malformed or dangling Exec= line now makes this browser resolve
    to None -- routing falls back to another browser instead of trying to
    exec whatever the line said."""
    desktop_id = BROWSER_DESKTOP_IDS[browser_id]
    for directory in APPLICATION_DIRS:
        path = directory / desktop_id
        if not path.is_file():
            continue
        for line in path.read_text().splitlines():
            if line.startswith("Exec="):
                exec_line = line[len("Exec=") :].strip()
                if not exec_line:
                    continue
                resolved = shutil.which(exec_line.split()[0])
                if resolved is not None:
                    return resolved
    return None


_DOMAIN_RE = re.compile(r"^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$")


def is_valid_domain(domain: str) -> bool:
    return bool(domain) and bool(_DOMAIN_RE.match(domain))


_URL_RE = re.compile(r"^(https?)://([^/?#]*)([/?#].*)?$", re.IGNORECASE)


def extract_host(url: str) -> str | None:
    """Hostname from `url`, or None to fail closed.

    Deliberately not a full URL parser. Real WHATWG URL parsing is needed
    for correctness, not just convenience -- an earlier version of this
    tool shelled out to Node's URL() for exactly that reason, after a
    hand-rolled parser disagreed with Chromium on backslashes in the
    authority and let a crafted link bypass routing (docs/codex-review.md).
    Dropping Node meant finding a way to keep that guarantee without a
    second language, and no Python stdlib or GLib parser is WHATWG-correct
    either (both tested against that exact attack URL and got it wrong the
    same way the original bug did).

    The approach here sidesteps needing a correct parser at all: accept
    only the subset of URLs where no parser could disagree in the first
    place (plain ASCII scheme+host+port, no userinfo, no percent-encoding,
    no backslashes, no IPv6 literals -- see the character checks below),
    and fail closed for everything else. Verified this subset is a strict
    match for real WHATWG parsing (not just internally consistent) by
    cross-checking every accepted case against Node's URL() directly.
    Rejecting more than strictly necessary costs nothing here: a link that
    fails this falls back to the default browser exactly like a
    genuinely-invalid URL would, it just doesn't get per-domain routing.
    """
    m = _URL_RE.match(url)
    if not m:
        return None
    authority = m.group(2)
    if not authority or not authority.isascii() or any(c in authority for c in "@\\%[]"):
        return None
    if ":" in authority:
        host, _, port = authority.rpartition(":")
        if not port.isdigit():
            return None
    else:
        host = authority
    host = host.lower()
    return host if is_valid_domain(host) else None


class ConfigError(Exception):
    """Config failed to load or validate. Message is human-readable."""


def load_raw(path: Path) -> dict:
    if not path.exists():
        raise ConfigError(f"config file not found: {path}")
    try:
        with path.open("r") as f:
            data = yaml.safe_load(f)
    except yaml.YAMLError as e:
        raise ConfigError(f"invalid YAML in {path}: {e}") from e

    if data is None:
        data = {}
    if not isinstance(data, dict):
        raise ConfigError(f"{path}: top level must be a mapping, got {type(data).__name__}")
    return data


def validate(data: dict) -> list[str]:
    """Return a list of error strings. Empty list means valid."""
    errors: list[str] = []
    known_keys = set(BROWSER_IDS) | {"default"}

    for key in data:
        if key not in known_keys:
            errors.append(
                f"unknown key '{key}' (expected 'default' or one of: {', '.join(BROWSER_IDS)})"
            )

    if "default" not in data:
        errors.append("missing required key 'default'")
    elif data["default"] not in DEFAULT_VALUES:
        errors.append(f"'default: {data['default']!r}' must be 'ask' or one of: {', '.join(BROWSER_IDS)}")

    seen: dict[str, str] = {}
    for browser in BROWSER_IDS:
        if browser not in data:
            continue
        domains = data[browser]
        if not isinstance(domains, list):
            errors.append(f"'{browser}' must be a list of domains, got {type(domains).__name__}")
            continue
        for domain in domains:
            if not isinstance(domain, str) or not is_valid_domain(domain.lower()):
                errors.append(f"'{browser}' has an invalid domain entry: {domain!r}")
                continue
            domain = domain.lower()
            if domain in seen:
                if seen[domain] == browser:
                    errors.append(f"'{browser}' lists '{domain}' more than once")
                else:
                    errors.append(f"'{domain}' is listed under both '{seen[domain]}' and '{browser}'")
            else:
                seen[domain] = browser

    return errors


def load_validated(path: Path) -> dict:
    data = load_raw(path)
    errors = validate(data)
    if errors:
        raise ConfigError("\n".join(f"  - {e}" for e in errors))
    return data


def write_config(path: Path, data: dict) -> None:
    """Canonical form: `default`, then each BROWSER_IDS key in order with
    sorted lowercased domains. Same output regardless of which subcommand
    last wrote it."""
    ordered = {"default": data["default"]}
    for b in BROWSER_IDS:
        ordered[b] = sorted(d.lower() for d in data.get(b, []))
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w") as f:
        yaml.safe_dump(ordered, f, default_flow_style=False, sort_keys=False)


def resolve_explicit(data: dict, host: str) -> str | None:
    """Browser id explicitly routed for `host`, or None if nothing
    matches. Ties broken by longest (most specific) matching domain, not
    BROWSER_IDS order -- a broad rule must not silently beat a more
    specific rule for a subdomain routed elsewhere (docs/codex-review.md)."""
    if not host:
        return None
    host = host.lower()
    best_domain = None
    best_browser = None
    for browser in BROWSER_IDS:
        for domain in data.get(browser, []):
            domain = domain.lower()
            if host == domain or host.endswith("." + domain):
                if best_domain is None or len(domain) > len(best_domain):
                    best_domain = domain
                    best_browser = browser
    return best_browser


def resolve(data: dict, host: str) -> str:
    """Browser id for `host` -- always a real id, never "ask" itself."""
    default = data["default"]
    fallback = default if default != "ask" else FALLBACK_BROWSER
    if not host:
        return fallback
    explicit = resolve_explicit(data, host)
    return explicit if explicit is not None else fallback


def should_ask(data: dict, host: str) -> bool:
    """True only when default is "ask", host is non-empty, and it has no
    explicit route -- never for the empty-host case or an already-routed
    host."""
    return data.get("default") == "ask" and bool(host) and resolve_explicit(data, host) is None


def find_overlaps(data: dict) -> list[tuple[str, str, str, str]]:
    """Cross-browser parent/child domain pairs, (parent, parent_browser,
    child, child_browser). Not invalid -- resolve() already picks the
    child -- but worth surfacing in `check`."""
    entries = [(d.lower(), b) for b in BROWSER_IDS for d in data.get(b, [])]
    return [
        (parent, pb, child, cb)
        for parent, pb in entries
        for child, cb in entries
        if pb != cb and child.endswith("." + parent)
    ]


def cmd_check(args: argparse.Namespace) -> int:
    path = Path(args.config)
    try:
        data = load_raw(path)
    except ConfigError as e:
        print(f"FAIL: {e}", file=sys.stderr)
        return 1

    errors = validate(data)
    if errors:
        print(f"FAIL: {path} is invalid:", file=sys.stderr)
        for e in errors:
            print(f"  - {e}", file=sys.stderr)
        return 1

    print(f"OK: {path} is valid")
    print(f"default: {data['default']}")
    for browser in BROWSER_IDS:
        count = len(data.get(browser, []))
        if count:
            print(f"{browser}: {count} domain{'s' if count != 1 else ''}")

    for parent, pb, child, cb in find_overlaps(data):
        print(f"note: '{child}' ({cb}) is more specific than '{parent}' ({pb}) and takes precedence for it", file=sys.stderr)

    referenced = set() if data["default"] == "ask" else {data["default"]}
    referenced.update(b for b in BROWSER_IDS if data.get(b))
    for browser in sorted(referenced):
        if resolve_binary(browser) is None:
            print(f"warning: '{browser}' is configured but not installed (no {BROWSER_DESKTOP_IDS[browser]} found)", file=sys.stderr)

    return 0


def set_domain(data: dict, browser: str, domain: str) -> str:
    """Route `domain` -> `browser` in `data` in place (`domain` must
    already be is_valid_domain). Returns "set", "unchanged" (already
    routed to `browser`), or the conflicting browser's id (already routed
    elsewhere, data left untouched). Caller writes the config back only
    on "set"."""
    for other in BROWSER_IDS:
        if other != browser and domain in [d.lower() for d in data.get(other, [])]:
            return other
    if domain in [d.lower() for d in data.get(browser, [])]:
        return "unchanged"
    data.setdefault(browser, []).append(domain)
    return "set"


def reset_domain(data: dict, domain: str) -> str | None:
    """Remove `domain`'s route from `data` in place, from whichever
    browser has it (a domain is only ever routed to one). Returns that
    browser's id, or None if `domain` wasn't routed anywhere -- caller
    writes the config back only when a browser id comes back."""
    for browser in BROWSER_IDS:
        current = data.get(browser, [])
        remaining = [d for d in current if d.lower() != domain]
        if len(remaining) != len(current):
            data[browser] = remaining
            return browser
    return None


def cmd_set(args: argparse.Namespace) -> int:
    path = Path(args.config)
    domain = args.domain.strip().lower()

    if not is_valid_domain(domain):
        print(f"error: '{args.domain}' doesn't look like a plain domain (no scheme, path, or @)", file=sys.stderr)
        return 2

    try:
        data = load_validated(path)
    except ConfigError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1

    result = set_domain(data, args.browser, domain)
    if result == "set":
        write_config(path, data)
        print(f"Set '{domain}' -> '{args.browser}'")
        return 0
    if result == "unchanged":
        print(f"'{domain}' is already routed to '{args.browser}'")
        return 0
    print(f"error: '{domain}' is already routed to '{result}'; run 'reset {domain}' first", file=sys.stderr)
    return 1


def cmd_reset(args: argparse.Namespace) -> int:
    path = Path(args.config)
    domain = args.domain.strip().lower()

    if not is_valid_domain(domain):
        print(f"error: '{args.domain}' doesn't look like a plain domain (no scheme, path, or @)", file=sys.stderr)
        return 2

    try:
        data = load_validated(path)
    except ConfigError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1

    browser = reset_domain(data, domain)
    if browser is None:
        print(f"'{domain}' isn't routed to any browser")
        return 0

    write_config(path, data)
    print(f"Removed '{domain}' (was routed to '{browser}')")
    return 0


def cmd_get_default(args: argparse.Namespace) -> int:
    path = Path(args.config)
    try:
        data = load_validated(path)
    except ConfigError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1

    print(data["default"])
    return 0


def cmd_set_default(args: argparse.Namespace) -> int:
    path = Path(args.config)
    try:
        data = load_validated(path)
    except ConfigError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1

    old, new = data["default"], args.browser
    if new == old:
        print(f"default is already '{old}'")
        return 0

    data["default"] = new
    write_config(path, data)
    print(f"Set default: {old} -> {new}")
    return 0


def cmd_installed(args: argparse.Namespace) -> int:
    installed = [{"id": b, "label": BROWSER_LABELS[b]} for b in BROWSER_IDS if resolve_binary(b) is not None]
    print(json.dumps(installed))
    return 0


def cmd_binary(args: argparse.Namespace) -> int:
    binary = resolve_binary(args.browser)
    if binary is None:
        print(f"'{args.browser}' is not installed (no {BROWSER_DESKTOP_IDS[args.browser]} found)", file=sys.stderr)
        return 1
    print(binary)
    return 0


def cmd_resolve(args: argparse.Namespace) -> int:
    """Print the binary for a hostname (exit 0), or -- when default: ask
    should prompt for it -- print nothing and exit 3."""
    path = Path(args.config)
    try:
        data = load_validated(path)
    except ConfigError as e:
        print(str(e), file=sys.stderr)
        return 1

    if should_ask(data, args.host):
        return 3

    browser = resolve(data, args.host)
    binary = resolve_binary(browser)
    if binary is None:
        print(f"'{browser}' is not installed (no {BROWSER_DESKTOP_IDS[browser]} found)", file=sys.stderr)
        return 1
    print(binary)
    return 0


EPILOG = """examples:
  browser-router-config check
  browser-router-config set chrome google.com
  browser-router-config reset google.com
  browser-router-config get-default
  browser-router-config set-default brave
  browser-router-config set-default ask
  browser-router-config resolve google.com
"""


def build_parser() -> argparse.ArgumentParser:
    # --config lives on each subparser (not the top-level parser too):
    # defining it in both places lets the subparser's own default silently
    # clobber a value already parsed from the command line, so only
    # `check --config X` (after the subcommand) is supported.
    config_option = argparse.ArgumentParser(add_help=False)
    config_option.add_argument(
        "--config",
        default=str(DEFAULT_CONFIG_PATH),
        metavar="PATH",
        help=f"config file to use (default: {DEFAULT_CONFIG_PATH})",
    )

    parser = argparse.ArgumentParser(
        prog="browser-router-config",
        description="Validate, edit, and query browser-router's config.yaml.",
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command", metavar="command")

    sub.add_parser(
        "check",
        help="validate the config file and print a summary",
        description="Validate the config file: schema, domain syntax, no domain routed to "
                     "more than one browser. Prints the default, each configured browser's "
                     "domain count, and warnings for anything worth a second look (a "
                     "configured browser that isn't installed, a domain shadowed by a more "
                     "specific one routed elsewhere) without failing validation over it.",
        parents=[config_option],
    ).set_defaults(func=cmd_check)

    p_set = sub.add_parser(
        "set",
        help="route a domain to a browser",
        description="Route DOMAIN to BROWSER. Also covers DOMAIN's subdomains, unless one of "
                     "them is routed elsewhere already. Refuses (without changing anything) if "
                     "DOMAIN is already routed to a different browser -- run 'reset DOMAIN' "
                     "first.",
        parents=[config_option],
    )
    p_set.add_argument("browser", choices=BROWSER_IDS, help="browser id to route to")
    p_set.add_argument("domain", help="domain to route, e.g. example.com")
    p_set.set_defaults(func=cmd_set)

    p_reset = sub.add_parser(
        "reset",
        help="remove a domain's route",
        description="Remove DOMAIN's route, whichever browser it's currently routed to. "
                     "DOMAIN then falls back to the default (or ask mode) like any other "
                     "unlisted domain. A no-op, not an error, if DOMAIN wasn't routed to "
                     "begin with.",
        parents=[config_option],
    )
    p_reset.add_argument("domain", help="domain to remove, e.g. example.com")
    p_reset.set_defaults(func=cmd_reset)

    sub.add_parser(
        "get-default",
        help="print the current default (or 'ask')",
        description="Print the current default: a browser id, or 'ask' if ask mode is on.",
        parents=[config_option],
    ).set_defaults(func=cmd_get_default)

    p_set_default = sub.add_parser(
        "set-default",
        help="change the default, or turn on ask mode",
        description="Change what unlisted domains open in. BROWSER is a browser id, or the "
                     "literal value 'ask' to prompt instead of using a fixed browser.",
        parents=[config_option],
    )
    p_set_default.add_argument(
        "browser", choices=DEFAULT_VALUES, help="browser id, or 'ask'"
    )
    p_set_default.set_defaults(func=cmd_set_default)

    sub.add_parser(
        "installed",
        help="list installed browsers as JSON",
        description="Print every browser id that resolves to an installed .desktop entry, "
                     "as a JSON array of {id, label} objects.",
    ).set_defaults(func=cmd_installed)

    p_binary = sub.add_parser(
        "binary",
        help="print the executable for a browser id",
        description="Print the executable BROWSER's .desktop entry points at, or fail if "
                     "BROWSER isn't installed.",
    )
    p_binary.add_argument("browser", choices=BROWSER_IDS, help="browser id to look up")
    p_binary.set_defaults(func=cmd_binary)

    p_resolve = sub.add_parser(
        "resolve",
        help="print the binary a hostname routes to (or exit 3 to ask)",
        description="Resolve HOST to a browser executable the way bin/browser-router itself "
                     "would: print the binary and exit 0, or -- when ask mode should prompt "
                     "for HOST instead -- print nothing and exit 3.",
        parents=[config_option],
    )
    p_resolve.add_argument("host", help="hostname to resolve, or an empty string for the default")
    p_resolve.set_defaults(func=cmd_resolve)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    if not getattr(args, "command", None):
        parser.print_help()
        return 0
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
