#!/usr/bin/env python3
"""Opens a URL in whichever browser its domain is routed to, per
~/.config/browser-router/config.yaml. Registered as the default web
browser (share/applications/browser-router.desktop).

Imports browser-router-config directly rather than shelling out to it, so
there's no subprocess/argv boundary between our own two components -- the
one that remains is the final exec of a real browser, which always gets
`--` before the URL (a leading "-" would otherwise be parsed as that
program's own flag; see docs/codex-review.md).

Any failure -- unparseable URL, missing/invalid config, ask mode
unavailable -- falls back to launching brave directly.

-h/--help print usage and exit before anything else touches the URL:
other Omarchy tooling that treats the registered default browser like a
real browser binary probes it with --help (omarchy-launch-browser, to
detect Firefox-vs-Chromium flag names -- see README.md's Design notes
for why this exists at all). Without this, that probe would fail URL
parsing like any other non-URL input and pop a real browser window
navigated to the literal text "--help".
"""

import importlib.machinery
import importlib.util
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
FALLBACK_BROWSER = "brave"


def _parse_ask_timeout() -> float:
    # Runs at import time, before main()'s own try/except -- a bad value
    # here must not raise, or a malformed ASK_TIMEOUT_SECONDS would crash
    # the router before any URL is handled and before fallback() ever
    # runs, contradicting "every failure still opens a browser". A
    # non-positive value is nonsensical as a poll deadline (0 never lets
    # the popup answer in time; negative is immediately expired), so it's
    # treated the same as unparseable.
    try:
        value = float(os.environ.get("ASK_TIMEOUT_SECONDS", 30))
    except (TypeError, ValueError):
        return 30.0
    return value if value > 0 else 30.0


ASK_TIMEOUT_SECONDS = _parse_ask_timeout()

USAGE = """browser-router: opens a URL in whichever browser its domain is routed to
by ~/.config/browser-router/config.yaml (see browser-router-config).

Usage: browser-router [URL]"""


def fallback(url: str | None = None) -> None:
    """Last resort: launch *some* browser or die trying. Tries the
    hard-coded FALLBACK_BROWSER first (the common case, and independent
    of whether config/browser-router-config loaded at all), then --
    only if that's not actually installed -- every other browser id this
    machine has a .desktop entry for. Loads its own config module
    instance rather than relying on a caller's `brc`, since this can be
    reached before main() ever gets one (see the load_config_module()
    failure path). Only prints and exits if truly nothing on the system
    can be exec'd, instead of letting an uncaught FileNotFoundError from
    a missing `brave` silently drop the link with no window and no
    explanation."""
    argv = [FALLBACK_BROWSER, "--"] + ([url] if url else [])
    try:
        os.execvp(FALLBACK_BROWSER, argv)
    except OSError:
        pass

    try:
        brc = load_config_module()
        for browser_id in brc.BROWSER_IDS:
            binary = brc.resolve_binary(browser_id)
            if binary is None:
                continue
            try:
                os.execvp(binary, [binary, "--"] + ([url] if url else []))
            except OSError:
                continue
    except Exception:
        pass

    print(
        f"browser-router: no browser could be launched (tried '{FALLBACK_BROWSER}' "
        "and every other configured browser)",
        file=sys.stderr,
    )
    sys.exit(1)


def load_config_module():
    # browser-router-config has no .py suffix (it's a CLI command name), so
    # spec_from_file_location can't infer a loader for it -- give it one.
    path = str(SCRIPT_DIR / "browser-router-config")
    loader = importlib.machinery.SourceFileLoader("browser_router_config", path)
    spec = importlib.util.spec_from_file_location("browser_router_config", path, loader=loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def shell_call(*args: str) -> subprocess.CompletedProcess:
    """omarchy-shell shell call/summon, argv-list (no shell involved --
    nothing here needs shell quoting)."""
    return subprocess.run(["omarchy-shell", *args], capture_output=True, text=True)


def ask_and_resolve(brc, data: dict, host: str) -> str | None:
    """Summon the ask-mode popup and wait for an answer; None on any
    failure (busy, no shell, timeout, cancel) so the caller falls back the
    same as any other failure -- ask mode only ever adds a prompt, never
    weakens the fail-closed behavior. Mirrors Omarchy's own image-picker
    pattern for a script needing an answer from a Quickshell popup it
    can't block on: write the answer to a file, touch a second file to
    signal done, poll for that (see omarchy-menu-images)."""
    installed = [b for b in brc.BROWSER_IDS if brc.resolve_binary(b) is not None]
    if not installed:
        return None

    busy = shell_call("shell", "call", "browser-router.ask", "isBusy", "")
    if busy.returncode != 0 or busy.stdout.strip() == "true":
        return None

    # A private (mode 0700) directory, not two loose tempfile.mktemp()
    # names: mktemp only returns a name without creating it, so on a
    # shared host anyone who reads these paths out of this process's argv
    # (visible via /proc/<pid>/cmdline for the ~ASK_TIMEOUT_SECONDS the
    # popup is open) could plant a symlink at either path before the QML
    # side writes to it -- and a plain `>` redirect follows symlinks. A
    # 0700 directory closes that off categorically: no other user can
    # create anything inside it, symlink or otherwise, so the path being
    # visible in argv no longer matters for this. mkdtemp() creates it
    # atomically with that mode from the start, not via a later chmod.
    req_dir = tempfile.mkdtemp(prefix="browser-router-ask-")
    selection_file = os.path.join(req_dir, "selection")
    done_file = os.path.join(req_dir, "done")
    try:
        payload = json.dumps({
            "host": host,
            "browsers": [{"id": b, "label": brc.BROWSER_LABELS[b]} for b in installed],
            "selectionFile": selection_file,
            "doneFile": done_file,
        })
        summon = shell_call("shell", "summon", "browser-router.ask", payload)
        if summon.returncode != 0 or summon.stdout.strip() != "ok":
            return None

        deadline = time.monotonic() + ASK_TIMEOUT_SECONDS
        while not os.path.exists(done_file) and time.monotonic() < deadline:
            time.sleep(0.05)
        if not os.path.exists(done_file):
            shell_call("shell", "call", "browser-router.ask", "cancelAsk", "")
            return None

        lines = Path(selection_file).read_text().splitlines() if os.path.exists(selection_file) else []
        choice = lines[0] if lines else ""
        remember = lines[1] if len(lines) > 1 else ""
        if not choice:
            return None

        if remember == "remember":
            if brc.set_domain(data, choice, host) == "set":
                brc.write_config(brc.DEFAULT_CONFIG_PATH, data)

        return brc.resolve_binary(choice)
    finally:
        shutil.rmtree(req_dir, ignore_errors=True)


def main() -> None:
    url = sys.argv[1] if len(sys.argv) > 1 else ""

    if url in ("-h", "--help"):
        print(USAGE)
        return

    try:
        brc = load_config_module()
    except Exception:
        fallback(url)

    if not url:
        try:
            data = brc.load_validated(brc.DEFAULT_CONFIG_PATH)
            binary = brc.resolve_binary(brc.resolve(data, ""))
        except Exception:
            binary = None
        if not binary:
            fallback()
        os.execvp(binary, [binary])

    host = brc.extract_host(url)
    if not host:
        fallback(url)

    try:
        data = brc.load_validated(brc.DEFAULT_CONFIG_PATH)
    except Exception:
        fallback(url)

    if brc.should_ask(data, host):
        try:
            binary = ask_and_resolve(brc, data, host)
        except Exception:
            binary = None
    else:
        binary = brc.resolve_binary(brc.resolve(data, host))

    if not binary:
        fallback(url)

    os.execvp(binary, [binary, "--", url])


if __name__ == "__main__":
    main()
