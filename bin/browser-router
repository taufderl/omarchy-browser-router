#!/bin/bash
# Opens the given URL in whichever browser its domain is routed to by
# ~/.config/browser-router/config.yaml. Registered as the default web
# browser via share/applications/browser-router.desktop (see install.sh).
#
# This script only orchestrates; it does not parse URLs or the config
# itself. Hostname extraction uses Node's WHATWG URL parser (the standard
# Chromium implements) rather than shell string manipulation -- ad-hoc
# shell parsing disagreed with Chromium on backslashes in the authority
# component and let a crafted link bypass routing (see codlex-review.md).
# Domain -> browser matching and config validation live in
# browser-router-config (Python + PyYAML), for the same reason: don't
# reimplement a structured-data parser in Bash.
#
# Any failure along the way -- missing node/python3, an unreadable or
# invalid config, a URL that won't parse -- falls back to launching brave
# directly, so a config mistake can never silently open a link in some
# other configured browser.
#
# Every exec of node or a browser puts `--` before the untrusted URL. Without
# it, a URL argument starting with "-" is parsed as a CLI option of whatever
# it's handed to -- some Node options evaluate JavaScript, making that a
# local code-execution path, and a browser could just as well interpret it
# as one of its own flags. See codex-review.md.

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
CONFIG_TOOL="$SCRIPT_DIR/browser-router-config"

url="$1"

fallback() { exec brave -- "$@"; }

[[ -x $CONFIG_TOOL ]] || fallback "$url"

if [[ -z $url ]]; then
  binary="$("$CONFIG_TOOL" resolve "" 2>/dev/null)" || fallback
  [[ -z $binary ]] && fallback
  exec "$binary"
fi

command -v node >/dev/null || fallback "$url"

host="$(node -e '
  try {
    const u = new URL(process.argv[1]);
    if (u.protocol !== "http:" && u.protocol !== "https:") process.exit(1);
    process.stdout.write(u.hostname.toLowerCase());
  } catch {
    process.exit(1);
  }
' -- "$url")" || fallback "$url"

[[ -z $host ]] && fallback "$url"

binary="$("$CONFIG_TOOL" resolve "$host" 2>/dev/null)" || fallback "$url"
[[ -z $binary ]] && fallback "$url"

exec "$binary" -- "$url"
